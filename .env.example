# Frontend (copy to .env.local for development)

# Backend URL for contact + enrollment forms.
# Leave empty to use same-origin /api/... (Vite proxies to localhost:3001 in dev).
# VITE_API_URL=https://www.nautk.org

# Course data source: static (default) or api
VITE_COURSES_SOURCE=static

# Subdirectory deploy, e.g. https://example.com/nautk/ → VITE_BASE_PATH=/nautk/
# VITE_BASE_PATH=/

# Vite dev proxy target when VITE_API_URL is empty
VITE_DEV_API_PROXY=http://localhost:3001
